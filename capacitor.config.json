{
  "appId": "kr.lawdigest.vocaloop",
  "appName": "VocaLoop",
  "webDir": "dist",
  "ios": {
    "contentInset": "always",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 1500,
      "backgroundColor": "#2563EB",
      "showSpinner": false
    },
    "Keyboard": {
      "resize": "none",
      "style": "default"
    }
  }
}
